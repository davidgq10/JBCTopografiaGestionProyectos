{
  "name": "jbc-proyectos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm --filter @jbc/web build",
    "build:storybook": "pnpm --filter @jbc/web build:storybook",
    "dev": "pnpm --filter @jbc/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm -r --if-present test",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "test:e2e": "pnpm --filter @jbc/web test:e2e",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify:architecture": "node scripts/verify-architecture.mjs && pnpm --filter @jbc/contracts verify",
    "verify:ci": "pnpm verify && pnpm build:storybook && pnpm test:e2e --workers=1 --reporter=line && pnpm --filter @jbc/web test:pwa",
    "verify:database": "node scripts/verify-database.mjs",
    "verify:secrets": "node scripts/verify-secrets.mjs",
    "verify:sql": "node scripts/verify-sql-static.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm verify:architecture && pnpm verify:secrets && pnpm verify:sql && pnpm test:coverage && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
