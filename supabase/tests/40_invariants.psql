do $assert_assignment_history$
begin
  if (select count(*) from public.user_roles
      where user_id = '61000000-0000-4000-8000-000000000001'
        and role_id = '67000000-0000-4000-8000-000000000001') <> 2
     or (select count(*) from public.user_roles
      where user_id = '61000000-0000-4000-8000-000000000001'
        and role_id = '67000000-0000-4000-8000-000000000001'
        and revoked_at is null) <> 1
     or (select count(*) from public.role_permissions
      where role_id = '67000000-0000-4000-8000-000000000001'
        and permission_id = '67100000-0000-4000-8000-000000000001') <> 2
     or (select count(*) from public.role_permissions
      where role_id = '67000000-0000-4000-8000-000000000001'
        and permission_id = '67100000-0000-4000-8000-000000000001'
        and revoked_at is null) <> 1
     or (select count(*) from public.user_specialties
      where user_id = '61000000-0000-4000-8000-000000000001'
        and specialty_id = '67200000-0000-4000-8000-000000000001') <> 2
     or (select count(*) from public.user_specialties
      where user_id = '61000000-0000-4000-8000-000000000001'
        and specialty_id = '67200000-0000-4000-8000-000000000001'
        and archived_at is null) <> 1
     or (select count(*) from public.project_memberships
      where project_id = '65000000-0000-4000-8000-000000000001'
        and user_id = '61000000-0000-4000-8000-000000000001') <> 2
     or (select count(*) from public.project_memberships
      where project_id = '65000000-0000-4000-8000-000000000001'
        and user_id = '61000000-0000-4000-8000-000000000001'
        and ended_at is null) <> 1
     or (select count(*) from public.work_memberships
      where work_id = '66000000-0000-4000-8000-000000000001'
        and user_id = '61000000-0000-4000-8000-000000000001') <> 2
     or (select count(*) from public.work_memberships
      where work_id = '66000000-0000-4000-8000-000000000001'
        and user_id = '61000000-0000-4000-8000-000000000001'
        and ended_at is null) <> 1
     or (select count(*) from public.schedule_block_users
      where schedule_block_id = '68200000-0000-4000-8000-000000000003'
        and user_id = '61000000-0000-4000-8000-000000000001') <> 2
     or (select count(*) from public.schedule_block_users
      where schedule_block_id = '68200000-0000-4000-8000-000000000003'
        and user_id = '61000000-0000-4000-8000-000000000001'
        and ended_at is null) <> 1
     or (select count(*) from public.schedule_block_resources
      where schedule_block_id = '68200000-0000-4000-8000-000000000003'
        and resource_id = '68200000-0000-4000-8000-000000000001') <> 2
     or (select count(*) from public.schedule_block_resources
      where schedule_block_id = '68200000-0000-4000-8000-000000000003'
        and resource_id = '68200000-0000-4000-8000-000000000001'
        and ended_at is null) <> 1 then
    raise exception 'FAIL [historial de asignaciones]';
  end if;
  raise notice 'PASS [historial de asignaciones conserva una fila histórica y una activa]';
end;
$assert_assignment_history$;

