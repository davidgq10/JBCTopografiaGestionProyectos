\set ON_ERROR_STOP on
\pset pager off

begin;

create or replace function pg_temp.expect_sqlstate(
  p_label text,
  p_sql text,
  p_expected_state text
)
returns void
language plpgsql
as $expect$
declare
  actual_state text;
  actual_message text;
begin
  begin
    execute p_sql;
  exception when others then
    get stacked diagnostics
      actual_state = returned_sqlstate,
      actual_message = message_text;
    if actual_state = p_expected_state then
      raise notice 'PASS [%]: SQLSTATE % (%)', p_label, actual_state, actual_message;
      return;
    end if;
    raise exception 'FAIL [%]: esperaba %, obtuvo % (%)',
      p_label, p_expected_state, actual_state, actual_message;
  end;
  raise exception 'FAIL [%]: la operación fue aceptada', p_label;
end;
$expect$;

