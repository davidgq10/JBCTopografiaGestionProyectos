do $assert_historical_external$
begin
  if not exists (
    select 1 from public.external_procedures
    where id = '65500000-0000-4000-8000-000000000001'
      and not is_active and not monitoring_enabled
  ) then
    raise exception 'FAIL [desactivación histórica APT]';
  end if;
  raise notice 'PASS [desactivación histórica APT existente]';
end;
$assert_historical_external$;

