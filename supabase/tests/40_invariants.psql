do $assert_project_scope$
begin
  if (select count(*) from public.approval_decisions
      where project_id = '65000000-0000-4000-8000-000000000001' and work_id is null) <> 1
     or (select count(*) from public.approval_executions
      where project_id = '65000000-0000-4000-8000-000000000001' and work_id is null) <> 1
     or (select count(*) from public.notifications
      where project_id = '65000000-0000-4000-8000-000000000001' and work_id is null) <> 1
     or (select count(*) from public.audit_events
      where project_id = '65000000-0000-4000-8000-000000000001' and work_id is null) <> 1
     or (select count(*) from public.outbox_events
      where project_id = '65000000-0000-4000-8000-000000000001' and work_id is null) <> 1 then
    raise exception 'FAIL [alcance directo de Proyecto]';
  end if;
  raise notice 'PASS [alcance directo de Proyecto end-to-end en persistencia]';
end;
$assert_project_scope$;

select 'F2-INVARIANTS PASS' as result;
rollback;
