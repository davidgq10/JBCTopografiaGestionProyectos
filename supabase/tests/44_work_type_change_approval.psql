select pg_temp.expect_sqlstate(
  'aprobación consumida no se reutiliza',
  $$update public.works set
      work_type_id=(select work_type_id from public.work_type_config_versions where id='7f000000-0000-4000-8000-000000000009'),
      configuration_version_id='7f000000-0000-4000-8000-000000000009',
      internal_state_id='7f000000-0000-4000-8000-00000000000a'
    where id='7f000000-0000-4000-8000-00000000000b'$$,
  '23514'
);

do $assert_type_change$
begin
  if (select count(*) from public.work_type_history
      where work_id='7f000000-0000-4000-8000-00000000000b') <> 1
     or (select status from public.approval_requests
      where id='7f000000-0000-4000-8000-000000000050') <> 'executed'
     or (select status from public.approval_executions
      where id='7f000000-0000-4000-8000-000000000052') <> 'succeeded'
     or exists (select 1 from public.external_procedures
      where id='7f000000-0000-4000-8000-000000000060'
        and (is_active or monitoring_enabled)) then
    raise exception 'FAIL [cambio de tipo aprobado exacto]';
  end if;
  raise notice 'PASS [cambio de tipo exacto consume aprobación y conserva APT histórico]';
end;
$assert_type_change$;

select 'F2-WORK-TYPE-APPROVAL PASS' as result;

rollback;
