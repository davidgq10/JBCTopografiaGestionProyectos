insert into public.work_type_config_versions
  (id, work_type_id, version_number, status, configuration)
select v.config_id, wt.id, v.version_number, 'active', '{}'::jsonb
from public.work_types wt
join (values
  ('plano_catastro', '7f000000-0000-4000-8000-000000000005'::uuid, 910),
  ('delimitacion', '7f000000-0000-4000-8000-000000000007'::uuid, 911),
  ('avaluo', '7f000000-0000-4000-8000-000000000009'::uuid, 912)
) v(type_code, config_id, version_number) on v.type_code = wt.code;

insert into public.work_state_definitions
  (id, work_type_id, configuration_version_id, code, name)
select v.state_id, c.work_type_id, c.id, 'cambio_tipo', 'Cambio de tipo'
from public.work_type_config_versions c
join (values
  ('7f000000-0000-4000-8000-000000000005'::uuid, '7f000000-0000-4000-8000-000000000006'::uuid),
  ('7f000000-0000-4000-8000-000000000007'::uuid, '7f000000-0000-4000-8000-000000000008'::uuid),
  ('7f000000-0000-4000-8000-000000000009'::uuid, '7f000000-0000-4000-8000-00000000000a'::uuid)
) v(config_id, state_id) on v.config_id = c.id;

