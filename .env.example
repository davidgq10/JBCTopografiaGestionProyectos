# Valores públicos del cliente. Nunca use aquí service_role ni secretos OAuth.
VITE_APP_ENV=local
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=REEMPLAZAR_CON_CLAVE_PUBLICABLE_LOCAL
VITE_FEATURE_ONEDRIVE=false
VITE_FEATURE_APT_SIRI=false
VITE_FEATURE_PUSH=false
VITE_FEATURE_AI=false

# Secretos exclusivamente para Supabase/servidor; no llevan prefijo VITE_.
SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_ID=REEMPLAZAR_EN_ENTORNO_SEGURO
SUPABASE_AUTH_EXTERNAL_AZURE_SECRET=REEMPLAZAR_EN_ENTORNO_SEGURO
SUPABASE_AUTH_EXTERNAL_AZURE_URL=https://login.microsoftonline.com/REEMPLAZAR_TENANT_ID
